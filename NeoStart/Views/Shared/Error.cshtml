@{
    ViewData["Title"] = "Error";
}

<div class="container text-center my-5">
    <h1 class="display-4 text-danger">Oops! Something went wrong.</h1>

    <p class="lead">
        @ViewBag.ExceptionMessage
    </p>

    @if (ViewBag.ExceptionPath != null)
    {
        <p class="text-muted">
            <strong>Path:</strong> <code>@ViewBag.ExceptionPath</code>
        </p>
    }

    @if (ViewBag.StackTrace != null)
    {
        <h5 class="mt-4">Stack Trace:</h5>
        <pre class="bg-light p-3">@ViewBag.StackTrace</pre>
    }

    <div>
        <a href="/" class="btn btn-primary mt-4">Go to Homepage</a>
        <a href="javascript:history.back()" class="btn btn-secondary mt-4">Go Back</a>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .container {
        max-width: 800px;
        margin-top: 100px;
    }

    .display-4 {
        font-size: 3rem;
        font-weight: 600;
        color: #dc3545;
    }

    .lead {
        font-size: 1.5rem;
        color: #6c757d;
    }

    .btn {
        margin-top: 20px;
        padding: 10px 20px;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
    }

    pre {
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>
