@{
    ViewData["Title"] = "Error";
}

<div class="container text-center my-5">
    <h1 class="display-4">Oops! Something went wrong.</h1>
    <p class="lead">
        @ViewBag.errorMessage
    </p>

    <p>
        The URL you tried to access does not exist or has been moved.
    </p>

    @if (ViewBag.Path != null && ViewBag.QS != null)
    {
        <p class="text-muted">
            <strong>Original Request:</strong> <code>@ViewBag.Path</code>?<code>@ViewBag.QS</code>
        </p>
    }

    <div>
        <a href="/" class="btn btn-primary">Go to Homepage</a>
        <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .container {
        max-width: 600px;
        margin-top: 100px;
    }

    .display-4 {
        font-size: 3rem;
        font-weight: 600;
        color: #dc3545;
    }

    .lead {
        font-size: 1.5rem;
        color: #6c757d;
    }

    .btn {
        margin-top: 20px;
        padding: 10px 20px;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
    }
</style>
