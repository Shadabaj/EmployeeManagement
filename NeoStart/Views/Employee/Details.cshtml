@model Models.EmployeeDetailsViewModel

<div class="container mt-5">
    <div class="row">
        <!-- Profile Image Section -->
        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Url.Content(Model.ProfileImage)" alt="Profile Image" class="img-fluid rounded-circle" style="max-width: 200px; height: auto;" />
            }
            else
            {
                <img src="https://via.placeholder.com/200" alt="Default Profile Image" class="img-fluid rounded-circle" style="max-width: 200px; height: auto;" />
            }
            <h4 class="mt-3">@Model.FirstName @Model.LastName</h4>
            <p class="text-muted">@Model.EmployeeCode</p>
        </div>

        <!-- Employee Details Section -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Employee Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Employee Code</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.EmployeeCode)</dd>

                        <dt class="col-sm-3">Full Name</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName) @Html.DisplayFor(model => model.LastName)</dd>

                        <dt class="col-sm-3">Email Address</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.EmailAddress)</dd>

                        <dt class="col-sm-3">Mobile Number</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.MobileNumber)</dd>

                        <dt class="col-sm-3">PAN Number</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.PanNumber)</dd>

                        <dt class="col-sm-3">Passport Number</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.PassportNumber)</dd>

                        <dt class="col-sm-3">Gender</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Gender)</dd>

                        <dt class="col-sm-3">Location</dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.CountryName),
                            @Html.DisplayFor(model => model.StateName),
                            @Html.DisplayFor(model => model.CityName)
                        </dd>

                        <dt class="col-sm-3">Date of Birth</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.DateOfBirth)</dd>

                        <dt class="col-sm-3">Date of Joining</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.DateOfJoinee)</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.IsActive)</dd>

                        <dt class="col-sm-3">Created Date</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedDate)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Buttons Section -->
    <div class="row mt-4">
        <div class="col">
            @Html.ActionLink("Edit", "Edit", new { id = Model.RowId }, new { @class = "btn btn-warning" })
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
